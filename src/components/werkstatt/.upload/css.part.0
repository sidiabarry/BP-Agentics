/**
 * Werkstatt v6 — Leistungsübersicht als 3D-Studio.
 *
 * Aufbau: Bühne (dunkles Studio mit Etiketten und Sheet) → Liste.
 * Übernimmt die Rolle der früheren LeistungsMaschine und damit auch ihren
 * Anschluss: Das Hellblau, in dem der Hero-Film endet (--hero-exit), läuft in
 * Tinte über; am Ende blendet die Sektion in Papier für die Problem-Sektion.
 * Keine Scroll-Pinning-Mechanik. Alles Klickbare sitzt in eigenen Ebenen mit
 * eigenem pointer-events, die Leinwand selbst nimmt Tippen und Wischen an.
 */

.ws {
  --ws-paper: #f3efe6;
  --ws-ink: #14161c;
  --ws-night: #0b1a27;
  --ws-portal: var(--hero-exit, #82bbf0);
  --ws-mist: #dbeaf6;
  --ws-action: #198be8;
  --ws-action-deep: #0b5ea8;
  --ws-action-hover: #1576c4;
  --ws-gutter: max(5vw, 1.5rem);
  --ws-header: calc(4.75rem + env(safe-area-inset-top, 0px));
  --ws-pad-top: 1.25rem;
  --ws-pad-bottom: max(12rem, 30svh);
  --ws-gap: 2rem;
  --ws-join: color-mix(in srgb, var(--ws-portal) 92%, var(--ws-night));
  position: relative;
  display: flex;
  flex-direction: column;
  overflow-x: clip;
  scroll-margin-top: var(--ws-header);
  margin-top: 0;
  padding: var(--ws-pad-top) 0 var(--ws-pad-bottom);
  color: #eaf3fa;
  background:
    linear-gradient(
      180deg,
      var(--ws-portal) 0,
      var(--ws-join) 22svh,
      color-mix(in srgb, var(--ws-portal) 72%, var(--ws-night)) 48svh,
      color-mix(in srgb, var(--ws-portal) 48%, var(--ws-night)) 78svh,
      color-mix(in srgb, var(--ws-portal) 26%, var(--ws-night)) 110svh,
      color-mix(in srgb, var(--ws-portal) 12%, var(--ws-night)) 142svh,
      var(--ws-night) 188svh
    ),
    var(--ws-night);
}

/* Übergang in die helle Folgesektion — wie bei der früheren LeistungsMaschine. */
.ws::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 36svh;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    transparent 0,
    color-mix(in srgb, var(--ws-paper) 10%, transparent) 28%,
    color-mix(in srgb, var(--ws-paper) 42%, transparent) 58%,
    color-mix(in srgb, var(--ws-night) 18%, var(--ws-paper)) 82%,
    var(--ws-paper) 100%
  );
}

/* --- Bühne ---------------------------------------------------------------- */

/* Randlos: die Bühne hat dieselbe Tinte wie die Sektion und läuft oben und unten weich aus. */
.ws__stage {
  position: relative;
  flex: 0 1 auto;
  height: min(68svh, calc(100svh - var(--ws-header) - 12.75rem), 720px);
  min-height: 28rem;
  overflow: hidden;
  background: transparent;
  color: var(--ws-paper);
  isolation: isolate;
}

.ws__poster,
.ws__poster img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.ws__poster img {
  object-fit: cover;
  transition: opacity 0.6s ease;
}

.ws[data-phase="ready"] .ws__poster img {
  opacity: 0;
}

.ws__canvas {
  position: absolute;
  inset: 0;
  z-index: 1;
  touch-action: pan-y;
  opacity: 0;
  transition:
    opacity 1.05s ease,
    top 0.35s ease;
}

/* Overview: canvas sits lower so pills can occupy the band above. */
.ws[data-phase="ready"][data-view="overview"] .ws__canvas {
  top: 5.25rem;
  right: 0;
  bottom: 0;
  left: 0;
  height: auto;
  inset: unset;
}

.ws[data-phase="ready"] .ws__canvas {
  opacity: 1;
}

.ws__canvas canvas {
  display: block;
  width: 100%;
  height: 100%;
  -webkit-tap-highlight-color: transparent;
}

.ws__progress {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  height: 3px;
  background: rgb(243 239 230 / 12%);
}

.ws__progress span {
  display: block;
  height: 100%;
  background: var(--ws-portal);
  transform-origin: left center;
  transition: transform 0.25s ease;
}

