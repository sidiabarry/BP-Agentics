
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  margin: 1.25rem 0 0;
  padding: 0 var(--ws-gutter);
  list-style: none;
}

.ws__list-link {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  height: 100%;
  padding: 1rem 1.1rem;
  border: 1px solid #ffffff1f;
  border-radius: 18px;
  background: #ffffff0c;
  color: #eaf3fa;
  text-decoration: none;
  transition:
    border-color 0.2s ease,
    background-color 0.2s ease;
}

.ws__list-link:hover {
  border-color: var(--ws-portal);
  background: #ffffff14;
}

.ws__list-num {
  font-family: var(--font-heading, var(--font-sora)), sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  line-height: 1.6;
  font-variant-numeric: tabular-nums;
  color: var(--ws-portal);
}

.ws__list-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 0.15rem;
}

.ws__list-name {
  font-family: var(--font-heading, var(--font-sora)), sans-serif;
  font-size: 1.05rem;
  font-weight: 600;
  color: #fff;
}

.ws__list-promise {
  font-size: 0.95rem;
  line-height: 1.4;
  color: #b9cfe0;
}

.ws__list-price {
  font-size: 0.92rem;
  font-weight: 600;
  white-space: nowrap;
  color: var(--ws-mist);
}

/* --- Fokus ---------------------------------------------------------------- */

.ws button:focus-visible,
.ws a:focus-visible,
.ws summary:focus-visible {
  outline: 3px solid var(--ws-portal);
  outline-offset: 3px;
}

.ws__sheet button:focus-visible,
.ws__sheet a:focus-visible,
.ws__sheet summary:focus-visible {
  outline-color: var(--ws-action);
}

.ws__sr {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

/* Solange die Bühne im Bild ist, liegt kein schwebender Knopf über Etiketten oder Liste. */
body:has(#werkstatt[data-stage-visible]) [data-analytics="whatsapp-fab"] {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

/* --- Handy und schmale Tablets --------------------------------------------- */

@media (max-width: 799px) {
  .ws {
    --ws-header: calc(4.75rem + env(safe-area-inset-top, 0px));
    --ws-pad-top: 0.85rem;
    --ws-pad-bottom: max(9rem, 28svh);
    --ws-gap: 1.25rem;
  }

  .ws__stage {
    height: min(40svh, calc(100svh - var(--ws-header) - 20.5rem));
    min-height: 16rem;
  }

  .ws__label {
    gap: 0.45rem;
    padding: 0.35rem 0.8rem 0.35rem 0.4rem;
    font-size: 0.9rem;
  }

  .ws__labels {
    --ws-label-clearance: 5rem;
  }

  .ws[data-phase="ready"][data-view="overview"] .ws__canvas {
    top: 3.75rem;
  }

  .ws__label-num {
    width: 1.75rem;
    height: 1.75rem;
  }

  .ws__label-long {
    display: none;
  }

  .ws__label-short {
    display: inline;
  }

  .ws__hint {
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .ws__sheet {
    top: auto;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.6rem;
    width: auto;
    max-height: 58%;
    padding: 0 1.1rem 1.1rem;
    border-radius: 20px;
    transform: translateY(24px);
  }

  .ws__sheet-bar {
    margin: 0 -1.1rem 0.4rem;
    padding: 0.6rem 0.7rem 0.4rem;
  }

  .ws__sheet h3 {
    margin: 0.2rem 0 0.5rem;
    font-size: 1.3rem;
  }

  .ws__text {
    margin-bottom: 0.7rem;
    font-size: 1rem;
  }

  .ws__price {
    margin-bottom: 0.8rem;
    font-size: 0.93rem;
  }

  .ws__cta,
  .ws__next {
    min-height: 46px;
    font-size: 0.98rem;
  }

  .ws__list {
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

}

@media (min-width: 800px) and (max-width: 1100px) {
  .ws__list {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ws *,
  .ws *::after {
    transition-duration: 0.01ms !important;
    transition-delay: 0s !important;
  }
}
