s ease 0.12s,
    transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) 0.08s,
    visibility 0s;
}

/* Bleibt beim Scrollen im Sheet oben stehen — „Übersicht" ist immer erreichbar. */
.ws__sheet-bar {
  position: sticky;
  top: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin: 0 -1.5rem 0.6rem;
  padding: 1.1rem 1rem 0.5rem;
  background: var(--ws-paper);
}

.ws__back {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  min-height: 44px;
  padding: 0 0.85rem 0 0.55rem;
  border: 1px solid rgb(20 22 28 / 14%);
  border-radius: 999px;
  background: #fff;
  font-size: 0.98rem;
  font-weight: 600;
  color: var(--ws-ink);
  cursor: pointer;
}

.ws__back:hover {
  border-color: var(--ws-action);
  color: var(--ws-action);
}

.ws__dots {
  display: flex;
  gap: 0.25rem;
}

.ws__dot {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  cursor: pointer;
}

.ws__dot span {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border: 1px solid rgb(20 22 28 / 18%);
  border-radius: 999px;
  font-size: 0.74rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: rgb(20 22 28 / 60%);
}

.ws__dot[aria-current="true"] span {
  border-color: var(--ws-ink);
  background: var(--ws-ink);
  color: var(--ws-paper);
}

.ws__kicker {
  margin: 0;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--ws-action-deep);
}

.ws__sheet h3 {
  margin: 0.35rem 0 0.7rem;
  font-family: var(--font-sora), sans-serif;
  font-size: 1.9rem;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.015em;
  outline: none;
}

.ws__text {
  margin: 0 0 0.9rem;
  font-size: 1.1rem;
  line-height: 1.5;
  color: rgb(20 22 28 / 78%);
}

.ws__price {
  margin: 0 0 1.1rem;
  padding: 0.6rem 0.8rem;
  border-radius: 12px;
  background: rgb(20 22 28 / 5%);
  font-size: 0.98rem;
  font-weight: 600;
  line-height: 1.35;
}

.ws__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.ws__cta,
.ws__next {
  display: inline-flex;
  flex: 1 1 auto;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 1.2rem;
  border-radius: 999px;
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}

.ws__cta {
  border: 1px solid var(--ws-action);
  background: var(--ws-action);
  color: #fff;
}

.ws__cta:hover {
  background: var(--ws-action-hover);
}

.ws__next {
  border: 1px solid rgb(20 22 28 / 16%);
  background: transparent;
  color: var(--ws-ink);
}

.ws__next:hover {
  border-color: var(--ws-ink);
}

.ws__more {
  margin-top: 1rem;
  padding-top: 0.8rem;
  border-top: 1px solid rgb(20 22 28 / 10%);
}

.ws__more summary {
  display: flex;
  align-items: center;
  min-height: 40px;
  font-weight: 600;
  cursor: pointer;
  list-style: none;
}

.ws__more summary::-webkit-details-marker {
  display: none;
}

.ws__more summary::after {
  content: "";
  width: 8px;
  height: 8px;
  margin-left: 0.6rem;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg) translateY(-3px);
  transition: transform 0.2s ease;
}

.ws__more[open] summary::after {
  transform: rotate(-135deg) translateY(-1px);
}

.ws__more ol {
  margin: 0.3rem 0 0.7rem;
  padding-left: 1.3rem;
  line-height: 1.55;
}

.ws__more p {
  margin: 0;
  font-size: 0.95rem;
  color: rgb(20 22 28 / 65%);
}

/* --- Liste unter der Bühne ------------------------------------------------ */

.ws__list {
  position: relative;
  z-index: 1;
  display: grid;